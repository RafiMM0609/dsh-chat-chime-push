# This plugin has no npm dependencies, but this guards against future additions.
node_modules/
pnpm-lock.yaml
package-lock.json
yarn.lock
.npm/
.pnpm-store/

# Local archives and build output (release zips are built outside the repo)
*.zip
*.tgz
dist/
build/
*.log

# Local configuration that must never be committed
.env
.env.*
!.env.example
*.local

# Test coverage and tooling caches
coverage/
.nyc_output/
.cache/
.tmp/
tsconfig.tsbuildinfo

# OS artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Backups and scratch files
*.bak
*.orig
*.rej
