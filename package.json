{
  "name": "@local/dsh-chat-chime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plays a short synthesized chime and shows an interactive completion card whenever a chat reply finishes in the DSH Web UI.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "bundle",
    "notification",
    "chime"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
